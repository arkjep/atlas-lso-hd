LSO_HD_BASE_URL=https://helpdesk.example.com/api
LSO_HD_API_TOKEN=
LSO_HD_URL_PATTERN=/tickets?/([^/?#]+)
LSO_HD_TICKET_PATH=/tickets/:id
LSO_HD_MESSAGES_PATH=/tickets/:id/messages
LSO_HD_REPLY_PATH=/tickets/:id/replies
LSO_HD_COMPLETE_PATH=/tickets/:id
LSO_HD_COMPLETE_METHOD=PATCH
LSO_HD_COMPLETE_BODY={"status":"completed"}
